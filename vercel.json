{
  "installCommand": "bun install",
  "buildCommand": "bun run vercel-build",
  "builds": [
    {
      "src": "api/server.vercel.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server.vercel.js"
    }
  ]
}
