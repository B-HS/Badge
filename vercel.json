{
  "installCommand": "bun install",
  "buildCommand": "bun run vercel-build",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/@fontsource/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/public/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api"
    }
  ]
}
